# Salin berkas ini menjadi .env lalu sesuaikan.
#
# PENTING: semua variabel berawalan VITE_ ikut tertanam di hasil build (dist/*.js)
# dan bisa dibaca siapa pun lewat DevTools browser. Isi hanya dengan nilai PUBLIK
# seperti alamat API. Jangan pernah menaruh password, APP_KEY, token, atau API key
# rahasia di sini.

# Alamat dasar API Laravel.
#   /api                        -> lewat proxy (npm run dev memakai proxy Vite,
#                                  container memakai proxy Nginx). Tanpa CORS.
#   http://127.0.0.1:8000/api   -> langsung ke Laravel. Butuh CORS (config/cors.php).
VITE_API_URL=/api
